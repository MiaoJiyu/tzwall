# 泰兴中学校园墙 — Nginx 反代示例
# 链路：浏览器 -> EdgeOne -> Nginx(10001) -> 后端(127.0.0.1:10002)
# EdgeOne 在边缘终结 SSL 并回源到 10001；源站不直接暴露 HTTPS。
# 真实客户端 IP 经 X-Forwarded-For 传递。
server {
    listen 10001;
    listen [::]:10001;
    server_name _;

    client_max_body_size 512m;

    # EdgeOne 回源时传递真实客户端 IP（如需更严格可替换为 EdgeOne 回源 IP 段）
    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # 前端静态资源（由 `npm run build` 生成的 dist 目录）
    root /opt/tzwall/frontend/dist;
    index index.html;

    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API 反向代理到后端（后端 SERVER_HOST=127.0.0.1、SERVER_PORT=10002）
    location /api/ {
        proxy_pass http://127.0.0.1:10002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # 单页应用路由回退
    location / {
        try_files $uri $uri/ /index.html;
    }

    access_log /var/log/nginx/tzwall.access.log;
    error_log /var/log/nginx/tzwall.error.log;
}
