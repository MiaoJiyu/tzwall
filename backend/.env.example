# ============================================
# 泰兴中学校园墙 — 环境变量示例
# 复制为 backend/.env 并按需修改。.env 仅服务进程可读，禁止下发前端。
# ============================================

# 服务端口。配合 Nginx 反代时建议设为 8080，由 Nginx 监听 80 回源。
SERVER_PORT=8080

# ---------- PostgreSQL ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=tzwall
DB_PASSWORD=
DB_NAME=tzwall
DB_SSLMODE=disable

# ---------- Redis（留空则自动降级为内存缓存）----------
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 安全 ----------
# JWT 签名密钥，请替换为长度足够的随机串
JWT_SECRET=change-me-please-use-a-long-random-secret
# AES-256-GCM 密钥（32 字节，base64 编码），用于加密 SMTP 密码等敏感字段
AES_KEY_B64=

# ---------- 腾讯云 COS（全部留空则使用本地磁盘存储，浏览器不直连）----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=
COS_BASE_URL=
# 数据万象审核策略模板（留空使用默认策略）；配置 Region/Bucket 后生效
COS_AUDIT_BIZ_TYPE=
# 审核回调校验 Token（留空则不校验，建议生产环境配置）
COS_CALLBACK_TOKEN=

# ---------- SMTP 邮件（留空则降级为不发送，找回密码不可用）----------
# 也可在后台「系统配置」中录入，后台配置优先于此处；密码经 AES 加密存储
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- 图片水印中文字体（可选）----------
# 说明：图片文件不再烧录水印（见阶段三变更），全站水印由前端覆盖层承担。
# 仅当需要为其他场景生成带字图片时才需要配置中文字体。
# Ubuntu 安装：apt-get install fonts-noto-cjk
# 注意：Go 字体库不支持 .ttc 集合，需使用单文件 TTF（如 Noto Sans SC）
# 留空则相关能力降级为不烧录
WATERMARK_FONT_PATH=

# ---------- 站点 ----------
SITE_NAME=泰兴中学校园墙
# EdgeOne 开启真实 IP 传递后的可信代理（逗号分隔，支持 CIDR）
TRUSTED_PROXIES=127.0.0.1

# ---------- 初始超级管理员（首次启动写入，库非空后不再覆盖）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
ADMIN_EMAIL=admin@tzwall.local
ADMIN_REAL_NAME=系统管理员
ADMIN_SCHOOL=泰兴中学
