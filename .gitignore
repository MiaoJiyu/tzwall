# ============================================
# 泰兴中学校园墙 — Git 忽略规则
# 技术栈：Go 后端 + Vue3/Vite 前端 + Nginx 部署
# ============================================

# ---------- 敏感配置（绝不入库）----------
# 含腾讯云 SecretId/SecretKey、JWT 密钥、AES 密钥、数据库密码
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets.*
auth.json

# ---------- 后端（Go）----------
# 编译产物
backend/tzwall
backend/*.exe
backend/*.test
backend/*.out
backend/server
backend/bin/
backend/dist/

# 本地数据：COS 未配置时的上传目录、SQLite 等
backend/data/
*.db
*.sqlite
*.sqlite3

# Go 覆盖率与工具缓存
coverage.txt
*.cover
profile.cov

# ---------- 前端（Vue3 + Vite）----------
node_modules/
frontend/node_modules/
frontend/.pnpm-store/
# 注意：frontend/public/ 下是站点静态资源（favicon、QQ/微信图标、小程序码、捐赠图等），需要入库，请勿整体忽略
frontend/public/**/*.tmp
frontend/public/app.png
frontend/public/donate.jpg

# 构建产物（由 deploy.sh 在服务器上构建）
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/.eslintcache

# 本地调试与日志
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/.output/
frontend/.nuxt/

# ---------- 日志与运行时 ----------
*.log
logs/
npm-debug.log*
nohup.out
core
core.*

# 维护模式运行时状态：标志文件与生成的维护页由程序/脚本生成，不入库
# （./maintenance.sh 与后台配置会自动创建 run/MAINTENANCE 与 run/maintenance.html）
run/

# 进程与套接字
*.pid
*.sock

# ---------- 测试与截图产物 ----------
.playwright-cli/
playwright-report/
test-results/
blob-report/
screenshots/
videos/
coverage/
.nyc_output/

# ---------- 备份文件 ----------
*.bak
*.backup
*.old
*.orig
*.rej
*.swp
*.swo
*~
*.tmp
*.temp

# ---------- 压缩包 ----------
*.gz
*.tgz
*.tar
*.zip
*.rar
*.7z

# ---------- 系统与编辑器 -----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
.project
.settings/
.classpath

# ---------- 代理与工具 ----------
.codebuddy/
.claude/
.cursor/
.aider*
.windsurf/

# ---------- 文档构建 -----------
docs/_build/
site/

# 云端仓库备份克隆（位于工作区内，避免误提交）
tzwall-backup/
